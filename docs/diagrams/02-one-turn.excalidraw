   "updated": 1,
   "link": null,
   "locked": false,
   "id": "text-1",
   "type": "text",
   "x": 40,
   "y": 70.75,
   "width": 1227.6000000000001,
   "height": 22.5,
   "text": "What run() in src/harness.ts does, in order. Each step, one model call; the loop repeats until the finish gate lets it stop.",
   "originalText": "What run() in src/harness.ts does, in order. Each step, one model call; the loop repeats until the finish gate lets it stop.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 16
  },
  {
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1139577630,
   "version": 1,
   "versionNonce": 1321323129,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "id": "text-2",
   "type": "text",
   "x": 1157.75,
   "y": 1260.625,
   "width": 544.5,
   "height": 18.75,
   "text": "Each check refuses at most twice, so the gate cannot lock the run.",
   "originalText": "Each check refuses at most twice, so the gate cannot lock the run.",
   "fontSize": 15,
   "fontFamily": 5,
   "textAlign": "center",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baseline": 14
  }
