{
  "name": "amness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A terminal coding agent for any model: streaming chat TUI, permission modes, plan mode, undo, memory, MCP, with a small reliability harness underneath. OpenAI (Responses API), Claude, and local models.",
  "license": "MIT",
  "author": "amirhossein jofreh <366054+amirsdream@users.noreply.github.com>",
  "homepage": "https://github.com/amirsdream/Amness#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirsdream/Amness.git"
  },
  "bugs": {
    "url": "https://github.com/amirsdream/Amness/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "cli",
    "tui",
    "llm",
    "openai",
    "responses-api",
    "claude",
    "anthropic",
    "mcp",
    "terminal",
    "typescript"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "amness": "./cli/amness.ts"
  },
  "scripts": {
    "start": "node cli/amness.ts",
    "chat": "node cli/amness.ts",
    "demo": "node cli/amness.ts demo",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "build": "tsc",
    "test": "node --test --test-timeout=180000 \"test/**/*.test.ts\"",
    "test:pty": "python3 test/pty/tui.py"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  }
}
